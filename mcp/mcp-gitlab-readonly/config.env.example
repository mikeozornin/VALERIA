# Use scope api for REST writes. GITLAB_READ_TOKEN remains a read-only fallback.
GITLAB_TOKEN=glpat-replace-me

# GitLab REST API origin. Defaults to https://gitlab.com when omitted.
# Set this for any self-managed GitLab instance.
GITLAB_URL=https://gitlab.example.com

# Legacy default root, used when GITLAB_REPOSITORY_ROOTS is not set.
GITLAB_CLONE_ROOT=/home/appuser/gitlab-readonly

# Full CI job traces returned by gitlab_get_job_trace are saved here.
GITLAB_TRACE_OUTPUT_DIR=/home/appuser/gitlab-traces

# Job artifacts downloaded by gitlab_get_job_artifact go to a sibling
# gitlab-artifacts directory; downloads above this size are rejected.
# GITLAB_MAX_ARTIFACT_BYTES=100000000
# Comma-separated, exact HTTPS hosts allowed for GitLab artifact redirects.
# The GitLab token is not forwarded to these hosts.
# GITLAB_ARTIFACT_REDIRECT_HOSTS=artifacts.example.com

# Colon-separated allowlist for clone and all local Git operations.
GITLAB_REPOSITORY_ROOTS=/home/appuser/projects:/home/appuser/work

# Absolute destination/repository paths are accepted exactly as provided by default.
# Set false to restrict absolute paths to GITLAB_REPOSITORY_ROOTS.
GITLAB_ALLOW_ABSOLUTE_PATHS=true

# All clone/fetch/pull/push operations are restricted to this SSH route.
# By default the hostname is derived from GITLAB_URL; override it only when
# the Git SSH endpoint uses a different hostname.
# GITLAB_SSH_HOST=ssh.gitlab.example.com
GITLAB_SSH_USER=git
# GITLAB_SSH_PORT=22
# GITLAB_SSH_IDENTITY_FILE=/home/appuser/.ssh/id_ed25519
# GITLAB_SSH_KNOWN_HOSTS_FILE=/home/appuser/.ssh/known_hosts

# Optional path to a custom CA bundle. TLS verification is never disabled.
# GITLAB_CA_BUNDLE=/path/to/ca-bundle.pem

# Environment proxy variables are ignored by default. Enable only if required.
# GITLAB_TRUST_ENV_PROXY=true
