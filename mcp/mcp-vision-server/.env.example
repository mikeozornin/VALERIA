# Export these variables or set them in the MCP client's environment block.
# The server does not automatically read .env files.
VISION_BASE_URL=http://localhost:8080/v1
VISION_MODEL=Qwen/Qwen35-122B-A10B-FP8
VISION_TIMEOUT_SECONDS=60000
VISION_MAX_IMAGE_MB=20
VISION_MAX_IMAGE_PIXELS=40000000
VISION_MAX_TOKENS=4096
VISION_ENABLE_THINKING=false
VISION_ALLOWED_ROOTS=/home/appuser
