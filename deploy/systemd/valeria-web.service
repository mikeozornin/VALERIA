[Unit]
Description=Valeria OpenCode Web and managed OpenCode processes
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=root
WorkingDirectory=/opt/valeria
Environment=PATH=/root/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LANG=en_US.UTF-8
ExecStart=/opt/valeria/deploy/run-service.sh web
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=45
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
