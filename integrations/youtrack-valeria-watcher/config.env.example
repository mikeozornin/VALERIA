# State and source configuration
WATCHER_DB_PATH=/var/lib/youtrack-valeria-watcher/state.db
WATCHER_LOCK_PATH=/run/youtrack-valeria-watcher/watcher.lock
OPENCODE_CONFIG=/root/.config/opencode/opencode.jsonc
YOUTRACK_MCP_NAME=youtrack.example.com
TLS_CA_BUNDLE=/opt/valeria/.secrets/ca/ca-certificates.crt

# Exact author names returned by get_issue_comments for the Valeria account.
# Multiple aliases can be separated with commas.
YOUTRACK_VALERIA_AUTHORS=Valeria
YOUTRACK_MENTION=@Valeria

# Dedicated Valeria task-only account and pre-created task.
VALERIA_BASE_URL=http://127.0.0.1:8080
VALERIA_LOGIN=youtrack-watcher
VALERIA_PASSWORD=replace-me
VALERIA_TASK_ID=00000000-0000-4000-8000-000000000000

# Safety limits. The scan window is fixed at one hour.
WATCHER_REQUEST_TIMEOUT_SECONDS=60
WATCHER_MAX_ISSUE_PAGES=500
WATCHER_MAX_COMMENT_PAGES=1000
WATCHER_MCP_CONCURRENCY=8
